ANALYZER_MODE=mock
META_API_KEY=
META_MODEL=muse-spark-1.3
META_BASE_URL=https://api.meta.ai/v1
META_MAX_COMPLETION_TOKENS=2048
META_TIMEOUT_SECONDS=45
META_REASONING_EFFORT=low
META_SAM_MODEL=sam-3.1
POSTGRES_PASSWORD=local-demo-only
COOKIE_SECURE=false

# Neon pooled URL for runtime; direct URL for schema migrations. Keep both private.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Optional exact HTTPS origin for passkeys; Render's external URL is used automatically.
WEBAUTHN_ORIGIN=
# Optional policy synthesis model supported by META_BASE_URL; defaults to META_MODEL.
POLICY_MODEL=

# Shared invoice explanations + clip scripts. Set either limit to 0 for unlimited.
EXPLANATION_ACCOUNT_HOURLY_LIMIT=100
EXPLANATION_GLOBAL_HOURLY_LIMIT=500
